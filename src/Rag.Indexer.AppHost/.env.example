# Copy this file to .env (in the same directory) and adjust values.
# The .env file is git-ignored; this template is committed for reference.
#
# Optional Qdrant API key.
#   - Leave empty (default): Qdrant runs WITHOUT authentication, so its web
#     dashboard opens directly without asking for a key.
#   - Set a value here: Qdrant authentication is enabled and you must enter
#     this key in the dashboard.
Qdrant:ApiKey=
